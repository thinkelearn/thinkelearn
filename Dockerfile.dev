FROM python:3.13-slim-bookworm

# Install system packages
RUN apt-get update --yes --quiet && apt-get install --yes --quiet --no-install-recommends \
    build-essential \
    libpq-dev \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    libwebp-dev \
    curl \
    git \
 && rm -rf /var/lib/apt/lists/*

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

WORKDIR /app

# Copy dependency files
COPY pyproject.toml uv.lock ./
COPY package.json ./

# Keep development/test tools in this image; requirements.txt is production-only.
RUN pip install --no-cache-dir uv \
 && uv export --frozen --all-extras --no-hashes --no-emit-project -o /tmp/requirements-dev.txt \
 && uv pip install --system --no-cache -r /tmp/requirements-dev.txt

# Install Node.js dependencies
RUN npm install

# Create non-root user
RUN useradd -m -s /bin/bash developer && chown -R developer:developer /app
USER developer

# Set environment variables
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
